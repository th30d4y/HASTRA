# Database
DATABASE_URL=postgresql://hastra:hastra_password@localhost:5432/hastra_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Key Encryption
ENCRYPTION_KEY=your-fernet-key-change-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=true

# Admin
ADMIN_EMAIL=admin@hastra.local
ADMIN_PASSWORD=admin_change_me
